# Supabase Configuration for TOM Mechanism Showcase
# Copy this file to .env and fill in your values from:
#   Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON=your_anon_public_key_here

# Optional: Override the admin password via environment variable.
# If not set, the SHA-256 hash check in supabaseClient.js is used.
# VITE_ADMIN_PASSWORD=your_admin_password_here
